# Use specific version, not 'latest'
FROM registry.redhat.io/ubi8/ubi-minimal:8.10

# Update packages for security patches
RUN microdnf update -y && \
    microdnf clean all

# Create non-root user and app directory
# OpenShift compatible (group 0)
RUN mkdir -p /app && \
    chgrp -R 0 /app && \
    chmod -R g=u /app

# Install only what you actually need
# Example: if you need a web server
# RUN microdnf install -y nginx && microdnf clean all

# Copy application files
# COPY --chown=1001:0 ./app /app

# Security: Remove unnecessary setuid binaries
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} \; || true

# Security: Remove shells if not needed (comment out if you need /bin/sh)
# RUN rm -f /bin/sh /bin/bash /usr/bin/sh /usr/bin/bash

# Clean up
RUN rm -rf /var/cache/* /tmp/* /var/tmp/* /var/log/*

# Metadata
LABEL name="ubi8-minimal-secure" \
      version="1.1" \
      description="Hardened UBI8 minimal for OpenShift" \
      io.openshift.tags="runtime,ubi8" \
      io.k8s.description="Secure minimal container"

# Run as non-root (OpenShift will override UID but respect non-root)
#USER 1001

WORKDIR /app

# Use exec form for proper signal handling
CMD ["/bin/sh", "-c", "echo 'Running...'; sleep 36000"]
